# LLM API 配置
# 复制本文件为 .env，然后填入你的 API 密钥
# 部署到 Streamlit Cloud 时，等价配置写入 .streamlit/secrets.toml（Secrets 优先于环境变量）

# 访问口令：设置后内部人员需凭口令进入（不设置则完全放行）
# APP_PASSWORD=your-internal-password

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI 兼容 API Key（可选；也可用于 DeepSeek / 通义 / 文心等国内模型）
OPENAI_API_KEY=your_openai_api_key_here

# 默认使用的 LLM 提供商：anthropic 或 openai
LLM_PROVIDER=anthropic

# 模型名（可选，默认 anthropic 路径 claude-opus-4-7，openai 路径 gpt-4o-mini）
# LLM_MODEL=claude-opus-4-7

# OpenAI 兼容接口地址（可选，用于国内模型服务，如 https://api.deepseek.com/v1）
# LLM_BASE_URL=

# 演示模式：设置为 true 时，不调用真实 LLM，使用模拟结果
USE_DEMO_MODE=false
